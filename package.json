{
  "name": "@lipemat/wordpress-libs",
  "version": "12.1.2",
  "description": "WP-Libs JS.",
  "author": "Mat Lipe <mat@onpointplugins.com>",
  "license": "UNLICENSED",
  "brotliFiles": true,
  "jsPath": "./js",
  "shortCssClasses": false,
  "url": "https://localhost",
  "scripts": {
    "analyze": "lipemat-js-boilerplate analyze",
    "browserslist": "lipemat-js-boilerplate browserslist",
    "dist": "lipemat-js-boilerplate dist",
    "lint": "lipemat-js-boilerplate lint && stylelint js/src/**/*.pcss --fix --cache",
    "postinstall": "lipemat-js-boilerplate fix-pnp",
    "start": "node -e \"console.error('`yarn lipemat-js-boilerplate start` may be called, but be sure to `dist` before committing.')\"",
    "dangerous-start": "lipemat-js-boilerplate start",
    "start-sass": "sass --watch ./css/ --style compressed",
    "test": "lipemat-js-boilerplate test"
  },
  "certificates": {
    "cert": "./dev/certs/localhost.crt",
    "key": "./dev/certs/localhost.key"
  },
  "dependencies": {
    "@types/select2": "^4.0.63",
    "sass": "^1.99.0"
  },
  "devDependencies": {
    "@lipemat/eslint-config": "^5.2.0",
    "@lipemat/js-boilerplate": "^11.0.0",
    "@lipemat/js-boilerplate-gutenberg": "^4.3.0",
    "@lipemat/js-boilerplate-shared": "^1.0.2",
    "@lipemat/stylelint-config": "^2.3.0",
    "@types/jquery": "3.5.34",
    "@types/lipemat__js-boilerplate": "github:lipemat/types-js-boilerplate#semver:^3",
    "@types/node": "22.19.15",
    "@types/react": "18.3.29",
    "@types/react-dom": "18.3.7",
    "@types/webpack-env": "1.18.8",
    "eslint": "9.39.4",
    "stylelint": "14.16.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "resolutions": {
    "@types/react": "~18.3.2",
    "@types/react-dom": "~18.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "packageManager": "yarn@4.15.0"
}
